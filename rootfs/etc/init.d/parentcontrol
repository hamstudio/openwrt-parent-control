#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/parentcontrold
CONF_DIR=/etc/parentcontrol
CONF_FILE=/etc/parentcontrol/config.json

start_service() {
    [ -d "$CONF_DIR" ] || mkdir -p "$CONF_DIR"
    
    # Ensure kmod-oaf is loaded
    [ -e "/dev/appfilter" ] || insmod oaf 2>/dev/null
    
    local tz="$(cat /etc/TZ 2>/dev/null || echo 'CST-8')"
    
    procd_open_instance
    procd_set_param command "$PROG" -config "$CONF_FILE" -port 8088
    [ -n "$tz" ] && procd_set_param env TZ="$tz"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="unlimited"
    procd_close_instance
}

stop_service() {
    # Gracefully terminate parentcontrold
    killall -TERM parentcontrold 2>/dev/null
    # Clean up iptables custom chains
    iptables -t filter -D FORWARD -j PARENT_CONTROL_FWD 2>/dev/null
    iptables -t nat -D PREROUTING -j PARENT_CONTROL_NAT_PRE 2>/dev/null
    iptables -t filter -F PARENT_CONTROL_FWD 2>/dev/null
    iptables -t filter -X PARENT_CONTROL_FWD 2>/dev/null
    iptables -t nat -F PARENT_CONTROL_NAT_PRE 2>/dev/null
    iptables -t nat -X PARENT_CONTROL_NAT_PRE 2>/dev/null
    rm -f /tmp/dnsmasq.d/parentcontrol.conf 2>/dev/null
    killall -HUP dnsmasq 2>/dev/null
}

reload_service() {
    stop
    start
}
